# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Reference-data refresh only. These keys are never exposed to the browser.
ONTONG_YOUTH_API_KEY=""
ONTONG_YOUTH_API_URL="https://www.youthcenter.go.kr/opi/youthPlcyList.do"
FINLIFE_API_KEY=""
FINLIFE_API_BASE_URL="https://finlife.fss.or.kr/finlifeapi"

# mock: bundled fixtures only / live: refresh scripts may call official APIs.
REFERENCE_DATA_MODE="mock"

# Claude API (서버에서만 사용. 브라우저에 노출되지 않는다.)
# ANTHROPIC_API_KEY: 값이 없으면 준비된 AI 응답과 규칙 기반 설명으로 동작한다.
# ANTHROPIC_MODEL: 사용할 모델명. 비워 두면 서버 기본값을 쓴다.
# AI_MODE: live(키가 있을 때 Claude 호출) 또는 fixture(준비된 응답 사용).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AI_MODE=fixture
